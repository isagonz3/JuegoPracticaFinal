<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane prefHeight="576" prefWidth="960" styleClass="bg-dark, border-accent" stylesheets="@game-style.css" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="jueguito.juegopracticafinal.Controladores.MenuController">

    <top>
        <VBox alignment="CENTER" spacing="20" style="-fx-padding: 80 0 40 0;">
            <Label styleClass="menu-title" text="A TAD of Adventure" />
            <Label styleClass="label-muted" text="Un juego de Estructuras de Datos" />
        </VBox>
    </top>

    <center>
        <VBox alignment="CENTER" spacing="15">
            <Button fx:id="nuevaPartidaBtn" styleClass="btn-menu" text="NUEVA PARTIDA" />
            <Button fx:id="cargarPartidaBtn" styleClass="btn-menu" text="CARGAR PARTIDA" />
            <Button fx:id="salirBtn" styleClass="btn-menu" text="SALIR" />
        </VBox>
    </center>

    <bottom>
        <TextArea editable="false" prefHeight="100" prefWidth="960" styleClass="controls-area" text="  CONTROLES: W/A/S/D o ↑/←/↓/→ : Moverse.....ESPACIO / ENTER: Atacar en la dirección actual.....E / TAB: Terminar turno (no hacer nada)" />
    </bottom>

</BorderPane>