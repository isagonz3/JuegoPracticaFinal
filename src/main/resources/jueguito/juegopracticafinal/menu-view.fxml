<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<VBox alignment="CENTER" spacing="20.0" xmlns:fx="http://javafx.com/fxml/1" xmlns="http://javafx.com/javafx/17.0.12" fx:controller="jueguito.juegopracticafinal.main.MenuController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>

    <Label style="-fx-font-size: 24; -fx-font-weight: bold;" text="A TAD of Adventure">
      <font>
         <Font name="Roboto Light" size="12.0" />
      </font></Label>
    <Button fx:id="nuevaPartidaBtn" text="Nueva Partida" />
    <Button fx:id="cargarPartidaBtn" text="Cargar Partida" />
    <Button fx:id="salirBtn" text="Salir" />
</VBox>
