<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<StackPane styleClass="menu-root" xmlns:fx="http://javafx.com/fxml/1"
           xmlns="http://javafx.com/javafx/17.0.12"
           fx:controller="jueguito.juegopracticafinal.Controladores.MenuController">

    <VBox alignment="CENTER" spacing="25.0">
        <padding>
            <Insets bottom="50.0" left="60.0" right="60.0" top="50.0" />
        </padding>

        <Label styleClass="game-title" text="A TAD of Adventure" />
        <Button fx:id="nuevaPartidaBtn" styleClass="menu-button"
                text="NUEVA PARTIDA" maxWidth="300" />
        <Button fx:id="cargarPartidaBtn" styleClass="menu-button"
                text="CARGAR PARTIDA" maxWidth="300" />
        <Button fx:id="salirBtn" styleClass="menu-button"
                text="SALIR" maxWidth="300" />
    </VBox>
</StackPane>