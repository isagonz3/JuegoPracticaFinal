<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.VBox?>

<VBox styleClass="end-root" xmlns:fx="http://javafx.com/fxml"
      fx:controller="jueguito.juegopracticafinal.Controladores.EndController"
      prefHeight="700" prefWidth="1100">

    <Label fx:id="resultadoLabel" />
    <TextArea fx:id="logFinal" styleClass="game-text-area"
              editable="false" wrapText="true"
              prefWidth="600" prefHeight="350" />
    <Button fx:id="volverBtn" styleClass="game-button"
            text="Volver al Menú" prefWidth="180" />
</VBox>
