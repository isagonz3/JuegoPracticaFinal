<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox alignment="CENTER" prefHeight="576" prefWidth="960" spacing="20" styleClass="bg-dark" stylesheets="@game-style.css" xmlns:fx="http://javafx.com/fxml/1" xmlns="http://javafx.com/javafx/17.0.12" fx:controller="jueguito.juegopracticafinal.Controladores.EndController">

    <padding><Insets bottom="40" left="80" right="80" top="40" /></padding>

    <!-- RESULTADO -->
    <Label fx:id="resultadoLabel" styleClass="end-title" text="Resultado" />

    <!-- LOG COMPLETO -->
    <Label styleClass="label-muted" text="— REGISTRO DE LA PARTIDA —" />

    <TextArea fx:id="logFinal" editable="false" prefHeight="300" prefWidth="600" VBox.vgrow="ALWAYS" />

    <!-- BOTÓN VOLVER -->
    <Button fx:id="volverBtn" styleClass="btn-menu" text="VOLVER AL MENÚ PRINCIPAL" />

</VBox>
