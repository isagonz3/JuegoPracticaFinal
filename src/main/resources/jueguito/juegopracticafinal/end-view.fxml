<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="jueguito.juegopracticafinal.Controladores.EndController"
            prefHeight="576" prefWidth="960">

    <Label fx:id="resultadoLabel" layoutX="50" layoutY="40"
           prefWidth="500" style="-fx-font-size: 24; -fx-font-weight: bold;" />

    <TextArea fx:id="logFinal" layoutX="50" layoutY="100"
              prefWidth="500" prefHeight="300" editable="false"
              style="-fx-font-family: monospace;" />

    <Button fx:id="volverBtn" layoutX="225" layoutY="430"
            text="Volver al Menú" prefWidth="150" />
</AnchorPane>