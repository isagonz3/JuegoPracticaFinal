<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane prefHeight="576" prefWidth="960" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="jueguito.juegopracticafinal.main.JuegoController">
    <padding><Insets bottom="10" left="10" right="10" top="10" /></padding>

    <top>
        <Label fx:id="zonaLabel" style="-fx-font-size: 18; -fx-font-weight: bold;" text="Zona: ?" />
    </top>

    <center>
        <ScrollPane fitToHeight="true" fitToWidth="true">
            <GridPane fx:id="mapaGrid" focusTraversable="true" gridLinesVisible="true" prefHeight="473.0" prefWidth="699.0" />
        </ScrollPane>
    </center>

    <right>
        <VBox alignment="BOTTOM_LEFT" spacing="10">
            <Label fx:id="turnoLabel" style="-fx-font-size: 14;" text="Turno: 0" />
            <Label fx:id="vidaLabel" text="Vida: 20/20" />
            <ProgressBar fx:id="vidaBar" prefWidth="180" />
            <Label fx:id="ataqueLabel" text="Ataque: 5" />
            <Label fx:id="defensaLabel" text="Defensa: 2" />
            <Label fx:id="movLabel" text="Rango Mov: 10" />
            <Label fx:id="puntosMovLabel" text="PM disp: 10" />
            <Label fx:id="armaLabel" text="Arma: ninguna" />
            <Label fx:id="escudoLabel" text="Escudo: ninguno" />

            <Label style="-fx-font-weight: bold; -fx-margin-top: 10;" text="--- Acciones ---" />
            <Button fx:id="terminarTurnoBtn" maxWidth="Infinity" text="Terminar Turno" />
            <Button fx:id="guardarBtn" maxWidth="Infinity" text="Guardar Partida" />
            <Button fx:id="menuBtn" maxWidth="Infinity" text="Abrir Menu" />

            <Label style="-fx-font-weight: bold; -fx-margin-top: 10;" text="--- Inventario ---" />
            <ListView fx:id="inventarioList" orientation="HORIZONTAL" prefHeight="120" prefWidth="200" />
            <HBox spacing="5">
                <Button fx:id="usarBtn" maxWidth="Infinity" text="Usar" HBox.hgrow="ALWAYS" />
                <Button fx:id="equiparBtn" maxWidth="Infinity" text="Equipar" HBox.hgrow="ALWAYS" />
                <Button fx:id="atacarBtn" maxWidth="Infinity" text="Atacar" HBox.hgrow="ALWAYS" />
                <Button fx:id="recogerBtn" maxWidth="Infinity" text="Recoger" HBox.hgrow="ALWAYS" />
            </HBox>
            <Label style="-fx-font-weight: bold; -fx-margin-top: 10;" text="--- Log ---" />
            <TextArea fx:id="logArea" editable="false" prefRowCount="12" prefWidth="200" />
        </VBox>
    </right>
</BorderPane>
