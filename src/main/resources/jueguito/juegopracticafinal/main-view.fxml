<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane styleClass="game-root" prefHeight="700" prefWidth="1100" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="jueguito.juegopracticafinal.Controladores.Juego.JuegoController">

    <!-- ZONA SUPERIOR -->
    <top>
        <VBox spacing="6">
            <Label fx:id="zonaLabel" styleClass="zone-label" text="ZONA: ?" />
            <HBox alignment="CENTER_LEFT" spacing="6">
                <Label fx:id="turnoLabel" styleClass="game-label" text="TURNO: 0" />
                <Label fx:id="vidaLabel" styleClass="game-label" text="VIDA: 20/20" />
                <ProgressBar fx:id="vidaBar" styleClass="game-progress-bar" prefWidth="130" />

                <Region HBox.hgrow="ALWAYS" />

                <Button fx:id="terminarTurnoBtn" styleClass="game-button" maxWidth="Infinity" text="SKIP" HBox.hgrow="ALWAYS" />
                <Button fx:id="entregarGatoBtn" styleClass="game-button" maxWidth="Infinity" text="GATO" HBox.hgrow="ALWAYS" />
                <Button fx:id="guardarBtn" styleClass="game-button" maxWidth="Infinity" text="GUARDAR" HBox.hgrow="ALWAYS" />
                <Button fx:id="deshacerMovimientoBtn" styleClass="game-button" maxWidth="Infinity" text="DESHACER" HBox.hgrow="ALWAYS" />
                <Button fx:id="atacarBtn" styleClass="game-button" maxWidth="Infinity" text="ATACAR" HBox.hgrow="ALWAYS" />
                <Button fx:id="interactuarBtn" styleClass="game-button" maxWidth="Infinity" text="INTERACTUAR" HBox.hgrow="ALWAYS" />
            </HBox>
        </VBox>
    </top>

    <!-- CENTRO: MAPA + TIENDA -->
    <center>
        <StackPane fx:id="mapaStackPane">
            <BorderPane.margin>
                <Insets top="8" right="30" bottom="8" left="30" />
            </BorderPane.margin>
            <GridPane fx:id="mapaGrid" alignment="CENTER" />
            <VBox fx:id="tiendaPanel" styleClass="shop-overlay" alignment="CENTER" spacing="15" visible="false">
                <Label text="TIENDA DEL COMERCIANTE" />
                <Label text="Barca - 5 gemas" />
                <Button fx:id="comprarBarcaBtn" text="Comprar" />
                <Label text="Mapa - 3 gemas" />
                <Button fx:id="comprarMapaBtn" text="Comprar" />
                <Button fx:id="salirTiendaBtn" text="Salir" />
            </VBox>
        </StackPane>
    </center>

    <!-- DERECHA: LOG + INVENTARIO + ESTADO -->
    <right>
        <VBox styleClass="right-panel" spacing="8">
            <Label styleClass="section-label" text="--- LOG ---">
                <VBox.margin><Insets top="6" right = "6"/></VBox.margin>
            </Label>
            <TextArea fx:id="logArea" styleClass="game-text-area" editable="false" wrapText="true"
                      prefHeight="180" prefWidth="220" />

            <Label styleClass="section-label" text="--- INVENTARIO ---" />
            <ListView fx:id="inventarioList" styleClass="game-list-view" prefHeight="100" prefWidth="220" />
            <HBox spacing="5">
                <Button fx:id="usarBtn" styleClass="game-button" maxWidth="Infinity" text="USAR" HBox.hgrow="ALWAYS" />
                <Button fx:id="equiparBtn" styleClass="game-button" maxWidth="Infinity" text="EQUIPAR" HBox.hgrow="ALWAYS" />
            </HBox>

            <Label styleClass="section-label" text="--- ESTADO DE OBJETOS ---" />
            <Label styleClass="game-label" text="Usados:" />
            <TextArea fx:id="objetosUsadosArea" styleClass="game-text-area" editable="false" wrapText="true"
                      prefHeight="60" prefWidth="220" />
            <Label styleClass="game-label" text="Equipados:" />
            <TextArea fx:id="objetosEquipadosArea" styleClass="game-text-area" editable="false" wrapText="true"
                      prefHeight="60" prefWidth="220" />
        </VBox>
    </right>

</BorderPane>
