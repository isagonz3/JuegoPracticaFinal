<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane prefHeight="576" prefWidth="960" stylesheets="@game-style.css" styleClass="bg-dark, border-accent"
            xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="jueguito.juegopracticafinal.Controladores.Juego.JuegoController">

    <padding><Insets bottom="5" left="5" right="5" top="5" /></padding>

    <top>
        <Label fx:id="zonaLabel" styleClass="label-title" text="Zona: ?" textAlignment="JUSTIFY" />
    </top>

    <center>
        <StackPane BorderPane.alignment="CENTER">

            <ScrollPane fitToHeight="true" fitToWidth="true" hbarPolicy="AS_NEEDED" vbarPolicy="AS_NEEDED">
                <GridPane fx:id="mapaGrid" alignment="CENTER" hgap="0" style="-fx-background-color: transparent; -fx-grid-lines-visible: false;" vgap="0" />
            </ScrollPane>

            <!-- TIENDA OVERLAY -->
            <VBox fx:id="tiendaPanel" alignment="CENTER" spacing="12" styleClass="bg-overlay, border-accent" visible="false">

                <Label styleClass="label-title" text="TIENDA DEL COMERCIANTE" />

                <Label styleClass="label-muted" text="Barca - 5 gemas" />
                <Button fx:id="comprarBarcaBtn" maxWidth="200" styleClass="btn-danger" text="Comprar Barca" />

                <Label styleClass="label-muted" text="Mapa - 3 gemas" />
                <Button fx:id="comprarMapaBtn" maxWidth="200" styleClass="btn-primary" text="Comprar Mapa" />

                <Button fx:id="salirTiendaBtn" maxWidth="200" styleClass="btn-purple" text="Salir de la tienda" />
            </VBox>

        </StackPane>
    </center>

    <right>
        <HBox spacing="12" styleClass="bg-panel, border-left">

            <VBox maxWidth="178" prefWidth="178" spacing="8">

                <Label fx:id="turnoLabel" styleClass="label-info, label-accent" text="Turno: 0" />

                <Label fx:id="vidaLabel" styleClass="label-info, label-heal" text="Vida: 20/20" />
                <ProgressBar fx:id="vidaBar" prefWidth="170" />

                <Label style="-fx-padding: 5 0 0 0;" styleClass="label-muted" text="— ACCIONES —" />

                <Button fx:id="terminarTurnoBtn" maxWidth="Infinity" styleClass="btn-purple" text="No realizar acción" />

                <Button fx:id="guardarBtn" maxWidth="Infinity" styleClass="btn-primary" text="Guardar Partida" />

                <HBox spacing="5">
                    <Button fx:id="atacarBtn" maxWidth="Infinity" styleClass="btn-danger" text="Atacar" HBox.hgrow="ALWAYS" />
                    <Button fx:id="interactuarBtn" maxWidth="Infinity" styleClass="btn-success" text="Interactuar" HBox.hgrow="ALWAYS" />
                </HBox>

                <Label style="-fx-padding: 5 0 0 0;" styleClass="label-muted" text="— LOG —" />

                <TextArea fx:id="logArea" editable="false" prefHeight="280" prefWidth="178" wrapText="true" VBox.vgrow="ALWAYS" />
            </VBox>

            <VBox maxWidth="178" prefWidth="178" spacing="8">

                <Label style="-fx-padding: 5 0 0 0;" styleClass="label-muted" text="— INVENTARIO —" />

                <ListView fx:id="inventarioList" prefHeight="150" prefWidth="178" />

                <HBox spacing="5">
                    <Button fx:id="usarBtn" maxWidth="Infinity" styleClass="btn-success" text="Usar" HBox.hgrow="ALWAYS" />
                    <Button fx:id="equiparBtn" maxWidth="Infinity" styleClass="btn-warning" text="Equipar" HBox.hgrow="ALWAYS" />
                </HBox>

                <Label style="-fx-padding: 5 0 0 0;" styleClass="label-muted" text="— ESTADO OBJETOS —" />

                <Label styleClass="label-muted" text="Usados:" />
                <TextArea fx:id="objetosUsadosArea" editable="false" prefHeight="70" prefWidth="178" wrapText="true" />

                <Label styleClass="label-muted" text="Equipados:" />
                <TextArea fx:id="objetosEquipadosArea" editable="false" prefHeight="70" prefWidth="178" wrapText="true" />
            </VBox>

        </HBox>
    </right>

</BorderPane>
