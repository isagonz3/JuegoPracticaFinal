<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane prefHeight="576" prefWidth="960"
            stylesheets="@game-style.css"
            styleClass="bg-dark"
            xmlns="http://javafx.com/javafx/17.0.12"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="jueguito.juegopracticafinal.Controladores.Juego.JuegoController">

    <padding><Insets bottom="5" left="5" right="5" top="5" /></padding>

    <!-- ZONA SUPERIOR -->
    <top>
        <Label fx:id="zonaLabel" text="Zona: ?"
               styleClass="label-title, border-bottom" />
    </top>

    <!-- CENTRO: MAPA + TIENDA -->
    <center>
        <StackPane BorderPane.alignment="CENTER">

            <ScrollPane fitToHeight="true" fitToWidth="true"
                        hbarPolicy="AS_NEEDED" vbarPolicy="AS_NEEDED">
                <GridPane fx:id="mapaGrid" alignment="CENTER"
                          hgap="0" vgap="0"
                          style="-fx-background-color: transparent;
                                 -fx-grid-lines-visible: false;" />
            </ScrollPane>

            <!-- TIENDA OVERLAY -->
            <VBox fx:id="tiendaPanel" alignment="CENTER" spacing="12"
                  styleClass="bg-overlay, border-accent, radius-10"
                  visible="false">

                <Label text="TIENDA DEL COMERCIANTE"
                       style="-fx-font-size: 20; -fx-font-weight: bold;
                              -fx-text-fill: #e94560;" />

                <Label text="Barca - 5 gemas"
                       style="-fx-text-fill: #e0e0e0; -fx-font-size: 14;" />
                <Button fx:id="comprarBarcaBtn" text="Comprar Barca"
                        maxWidth="200" styleClass="btn-danger" />

                <Label text="Mapa - 3 gemas"
                       style="-fx-text-fill: #e0e0e0; -fx-font-size: 14;" />
                <Button fx:id="comprarMapaBtn" text="Comprar Mapa"
                        maxWidth="200" styleClass="btn-primary" />

                <Button fx:id="salirTiendaBtn" text="Salir de la tienda"
                        maxWidth="200" styleClass="btn-purple" />
            </VBox>

        </StackPane>
    </center>

    <!-- DERECHA: PANEL DE CONTROL -->
    <right>
        <HBox spacing="12" styleClass="bg-panel, border-left"
              style="-fx-padding: 10;">

            <!-- COLUMNA 1: turno, vida, acciones, log -->
            <VBox maxWidth="178" prefWidth="178" spacing="8">

                <Label fx:id="turnoLabel" text="Turno: 0"
                       styleClass="label-info, label-accent" />

                <Label fx:id="vidaLabel" text="Vida: 20/20"
                       styleClass="label-info, label-heal" />
                <ProgressBar fx:id="vidaBar" prefWidth="170" />

                <Label text="— ACCIONES —" styleClass="label-muted"
                       style="-fx-padding: 5 0 0 0;" />

                <Button fx:id="terminarTurnoBtn" text="No realizar acción"
                        maxWidth="Infinity" styleClass="btn-purple" />

                <Button fx:id="guardarBtn" text="Guardar Partida"
                        maxWidth="Infinity" styleClass="btn-primary" />

                <HBox spacing="5">
                    <Button fx:id="atacarBtn" text="Atacar"
                            maxWidth="Infinity" HBox.hgrow="ALWAYS"
                            styleClass="btn-danger" />
                    <Button fx:id="interactuarBtn" text="Interactuar"
                            maxWidth="Infinity" HBox.hgrow="ALWAYS"
                            styleClass="btn-success" />
                </HBox>

                <Label text="— LOG —" styleClass="label-muted"
                       style="-fx-padding: 5 0 0 0;" />

                <TextArea fx:id="logArea" editable="false"
                          prefHeight="280" prefWidth="178"
                          wrapText="true" VBox.vgrow="ALWAYS" />
            </VBox>

            <!-- COLUMNA 2: inventario, objetos -->
            <VBox maxWidth="178" prefWidth="178" spacing="8">

                <Label text="— INVENTARIO —" styleClass="label-muted"
                       style="-fx-padding: 5 0 0 0;" />

                <ListView fx:id="inventarioList"
                          prefHeight="150" prefWidth="178" />

                <HBox spacing="5">
                    <Button fx:id="usarBtn" text="Usar"
                            maxWidth="Infinity" HBox.hgrow="ALWAYS"
                            styleClass="btn-success" />
                    <Button fx:id="equiparBtn" text="Equipar"
                            maxWidth="Infinity" HBox.hgrow="ALWAYS"
                            styleClass="btn-warning" />
                </HBox>

                <Label text="— ESTADO OBJETOS —" styleClass="label-muted"
                       style="-fx-padding: 5 0 0 0;" />

                <Label text="Usados:" styleClass="label-muted" />
                <TextArea fx:id="objetosUsadosArea" editable="false"
                          prefHeight="70" prefWidth="178" wrapText="true" />

                <Label text="Equipados:" styleClass="label-muted" />
                <TextArea fx:id="objetosEquipadosArea" editable="false"
                          prefHeight="70" prefWidth="178" wrapText="true" />
            </VBox>

        </HBox>
    </right>

</BorderPane>