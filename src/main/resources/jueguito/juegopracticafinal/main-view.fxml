<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.layout.HBox?>

<?import javafx.scene.layout.StackPane?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="jueguito.juegopracticafinal.main.JuegoController"
            prefHeight="576" prefWidth="960">

    <padding>
        <Insets bottom="10" left="10" right="10" top="10"/>
    </padding>

    <top>
        <Label fx:id="zonaLabel" text="Zona: ?"
               style="-fx-font-size: 18; -fx-font-weight: bold;" />
    </top>

    <center>

        <StackPane>

            <ScrollPane fitToWidth="true" fitToHeight="true">
                <GridPane fx:id="mapaGrid" />
            </ScrollPane>

            <VBox fx:id="tiendaPanel"
                  visible="false"
                  spacing="10"
                  alignment="CENTER"
                  style="-fx-background-color: rgba(0,0,0,0.7); -fx-padding: 20;">

                <Label text="TIENDA DEL COMERCIANTE"
                       style="-fx-font-size: 18; -fx-font-weight: bold; -fx-text-fill: white;" />

                <Label text="Barca - 5 gemas"
                       style="-fx-text-fill: white;" />

                <Button fx:id="comprarBarcaBtn"
                        text="Comprar" />

                <Label text="Mapa - 3 gemas"
                       style="-fx-text-fill: white;" />

                <Button fx:id="comprarMapaBtn"
                        text="Comprar" />

                <Button fx:id="salirTiendaBtn"
                        text="Salir" />

            </VBox>

        </StackPane>

    </center>

    <right>
        <VBox spacing="10" minWidth="200">

            <Label fx:id="turnoLabel" text="Turno: 0"
                   style="-fx-font-size: 14;" />

            <Label fx:id="vidaLabel" text="Vida: 20/20" />
            <ProgressBar fx:id="vidaBar" prefWidth="180" />

            <Label text="--- Acciones ---"
                   style="-fx-font-weight: bold;" />

            <Button fx:id="terminarTurnoBtn"
                    text="Terminar Turno"
                    maxWidth="Infinity"/>

            <Button fx:id="guardarBtn"
                    text="Guardar Partida"
                    maxWidth="Infinity"/>

            <HBox spacing="5">

                <Button fx:id="atacarBtn"
                        text="Atacar"
                        maxWidth="Infinity"
                        HBox.hgrow="ALWAYS"/>

                <Button fx:id="interactuarBtn"
                        text="Interactuar"
                        maxWidth="Infinity"
                        HBox.hgrow="ALWAYS"/>
            </HBox>

            <Label text="--- Inventario ---"
                   style="-fx-font-weight: bold;" />

            <ListView fx:id="inventarioList"
                      prefHeight="120"
                      prefWidth="200" />

            <HBox spacing="5">

                <Button fx:id="usarBtn"
                        text="Usar"
                        maxWidth="Infinity"
                        HBox.hgrow="ALWAYS"/>

                <Button fx:id="equiparBtn"
                        text="Equipar"
                        maxWidth="Infinity"
                        HBox.hgrow="ALWAYS"/>

            </HBox>

            <Label text="--- Estado de objetos ---"
                   style="-fx-font-weight: bold;" />

            <Label text="Objetos usados:" />

            <TextArea fx:id="objetosUsadosArea"
                      editable="false"
                      wrapText="true"
                      prefHeight="80"
                      prefWidth="200" />

            <Label text="Objetos equipados:" />

            <TextArea fx:id="objetosEquipadosArea"
                      editable="false"
                      wrapText="true"
                      prefHeight="80"
                      prefWidth="200" />

            <Label text="--- Log ---"
                   style="-fx-font-weight: bold;" />

            <TextArea fx:id="logArea"
                      editable="false"
                      wrapText="true"
                      prefHeight="250"
                      prefWidth="200" />

        </VBox>
    </right>

</BorderPane>