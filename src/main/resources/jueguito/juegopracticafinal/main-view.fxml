<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane prefHeight="700" prefWidth="1100" styleClass="game-root" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="jueguito.juegopracticafinal.Controladores.Juego.JuegoController">

    <!-- ZONA SUPERIOR -->
    <top>
        <VBox spacing="8.0">
            <padding>
                <Insets left="15.0" />
            </padding>

            <Label fx:id="zonaLabel" styleClass="zone-label" text="ZONA: ?" />

            <HBox alignment="CENTER_LEFT" spacing="6">
                <Label fx:id="turnoLabel" styleClass="game-label" text="TURNO: 0/0" />
            </HBox>

            <HBox alignment="CENTER_LEFT" spacing="6">
                <Label fx:id="vidaLabel" styleClass="game-label" text="VIDA: 20/20" />
                <ProgressBar fx:id="vidaBar" prefWidth="100.0" styleClass="game-progress-bar" />
            </HBox>

            <HBox alignment="CENTER_LEFT" spacing="6">
                <Button fx:id="terminarTurnoBtn" maxWidth="Infinity" prefHeight="26.0" styleClass="game-button" text="SKIP" HBox.hgrow="ALWAYS" />
                <Button fx:id="guardarBtn" maxWidth="Infinity" prefHeight="26.0" styleClass="game-button" text="GUARDAR" HBox.hgrow="ALWAYS" />
                <Button fx:id="deshacerMovimientoBtn" maxWidth="Infinity" prefHeight="26.0" styleClass="game-button" text="DESHACER" HBox.hgrow="ALWAYS" />
                <Button fx:id="atacarBtn" maxWidth="Infinity" prefHeight="26.0" styleClass="game-button" text="ATACAR" HBox.hgrow="ALWAYS" />
                <Button fx:id="interactuarBtn" prefHeight="26.0" prefWidth="154.0" styleClass="game-button" text="INTERACTUAR" HBox.hgrow="NEVER">
                    <HBox.margin><Insets right="5.0" /></HBox.margin>
                </Button>
            </HBox>
        </VBox>
    </top>

    <!-- CENTRO: MAPA + TIENDA -->
    <center>
        <StackPane fx:id="mapaStackPane">
            <BorderPane.margin>
                <Insets bottom="8" left="30" right="30" top="8" />
            </BorderPane.margin>
            <ScrollPane fx:id="mapaScrollPane" pannable="true" hbarPolicy="NEVER" vbarPolicy="NEVER" fitToWidth="false" fitToHeight="false">
            <GridPane fx:id="mapaGrid" alignment="CENTER" />
            </ScrollPane>
            <VBox fx:id="tiendaPanel" alignment="CENTER" spacing="15" styleClass="shop-overlay" visible="false">
                <Label text="TIENDA DEL COMERCIANTE" />
                <Label text="Barca - 5 gemas" />
                <Button fx:id="comprarBarcaBtn" text="Comprar" />
                <Label text="Mapa - 3 gemas" />
                <Button fx:id="comprarMapaBtn" text="Comprar" />
                <Button fx:id="salirTiendaBtn" text="Salir" />
            </VBox>
        </StackPane>
    </center>

    <!-- DERECHA: LOG + INVENTARIO + ESTADO -->
    <right>
        <VBox maxWidth="200" minWidth="100" spacing="8" styleClass="right-panel">
            <Label styleClass="section-label" text="--- LOG ---">
                <VBox.margin><Insets right="10" top="10" /></VBox.margin>
            </Label>
            <TextArea fx:id="logArea" editable="false" maxWidth="Infinity" prefHeight="180" styleClass="game-text-area" wrapText="true" />

            <Label styleClass="section-label" text="--- INVENTARIO ---" />
            <ListView fx:id="inventarioList" maxWidth="Infinity" prefHeight="100" styleClass="game-list-view" />
            <HBox maxWidth="Infinity" spacing="5">
                <Button fx:id="usarBtn" maxWidth="Infinity" styleClass="game-button" text="USAR" HBox.hgrow="ALWAYS" />
                <Button fx:id="equiparBtn" maxWidth="Infinity" styleClass="game-button" text="EQUIPAR" HBox.hgrow="ALWAYS" />
            </HBox>

            <Label styleClass="section-label" text="--- ESTADO DE OBJETOS ---" />
            <Label styleClass="game-label" text="Usados:" />
            <TextArea fx:id="objetosUsadosArea" editable="false" maxWidth="Infinity" prefHeight="60" styleClass="game-text-area" wrapText="true" />
            <Label styleClass="game-label" text="Equipados:" />
            <TextArea fx:id="objetosEquipadosArea" editable="false" maxWidth="Infinity" prefHeight="60" styleClass="game-text-area" wrapText="true" />
         <BorderPane.margin>
            <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
         </BorderPane.margin>
        </VBox>
    </right>

</BorderPane>
